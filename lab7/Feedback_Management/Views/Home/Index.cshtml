@model List<Feedback_Management.Models.Feedback>

@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-md-12">
        <div class="p-4 p-md-5 bg-white rounded-4 shadow-sm border d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="display-6 fw-bold text-dark mb-2">
                    <i class="bi bi-speedometer2 text-primary me-2"></i>Feedback Dashboard
                </h1>
                <p class="text-muted mb-0">Overview of overall system metrics and user submissions.</p>
            </div>
            <div>
                <a asp-controller="Feedback" asp-action="Index" class="btn btn-primary btn-lg rounded-3 fw-bold shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> Submit New Feedback
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-body p-4 border-start border-4 border-primary rounded-3">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-chat-left-text fs-3 text-primary"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">Total Submissions</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.TotalFeedbacks</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-body p-4 border-start border-4 border-warning rounded-3">
                <div class="d-flex align-items-center">
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-star fs-3 text-warning"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">Average Rating</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.AverageRating / 5.0</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-white">
            <div class="card-body p-4 border-start border-4 border-success rounded-3">
                <div class="d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-check-circle fs-3 text-success"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1">Response Rate</h6>
                        <h3 class="fw-bold mb-0">@ViewBag.ResponseRate</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white">
    <div class="card-header bg-white border-0 py-3 px-4">
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-list-stars me-2 text-primary"></i>Recent Feedbacks</h5>
    </div>
    <div class="table-responsive px-4 pb-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>User Name</th>
                    <th>Email</th>
                    <th>Rating</th>
                    <th>Comments</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@item.Email</td>
                            <td><span class="badge bg-primary">@item.Rating ⭐</span></td>
                            <td>@item.Comments</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-3">No feedback available yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>