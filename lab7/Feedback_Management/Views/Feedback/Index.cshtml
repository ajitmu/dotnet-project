@model Feedback_Management.Models.Feedback

@{
    ViewData["Title"] = "Feedback";
}

<div class="row justify-content-center py-2">
    <div class="col-xl-10 col-lg-11">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="row g-0">

                <!-- Left Banner Side -->
                <div class="col-md-5 bg-primary bg-gradient text-white p-4 p-xl-5 d-flex flex-column justify-content-between">
                    <div>
                        <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold mb-3 shadow-sm">
                            <i class="bi bi-heart-fill text-danger me-1"></i> Feedback
                        </span>
                        <h3 class="fw-bold mb-3">Your Opinion Drives Improvement</h3>
                        <p class="text-white-50 small mb-0">Help us make your experience better. Share what worked well or where we can improve.</p>
                    </div>

                    <div class="mt-4 pt-4 border-top border-white-20">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-shield-check fs-3 me-3 text-white-50"></i>
                            <div>
                                <h6 class="mb-0 fw-semibold fs-6">Confidential & Fast</h6>
                                <small class="text-white-50">Takes less than 2 minutes.</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Form Side -->
                <div class="col-md-7 bg-white p-4 p-xl-5">
                    <div class="mb-4">
                        <h4 class="fw-bold text-dark mb-1">Send Us Your Experience</h4>
                        <p class="text-muted small">Fill out the required details below.</p>
                    </div>

                    @Html.Partial("_FeedbackForm", Model)
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}