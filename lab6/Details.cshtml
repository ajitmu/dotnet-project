@model product.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="container my-5" style="max-width: 800px;">
    <div class="card shadow border-0 rounded-3 overflow-hidden">
        <div class="row g-0">
            <div class="col-md-5">
                <img src="@Model.ImageUrl" class="img-fluid h-100 w-100" style="object-fit: cover; min-height: 250px;" alt="@Model.Name" />
            </div>
            <div class="col-md-7">
                <div class="card-body p-4 d-flex flex-column h-100">
                    <div>
                        <span class="badge bg-secondary text-uppercase mb-2">@Model.Category</span>
                        <h2 class="fw-bold text-dark">@Model.Name</h2>
                        <h3 class="text-primary fw-bold my-3">₹@Model.Price.ToString("N2")</h3>
                        <p class="text-muted">@Model.Description</p>
                    </div>

                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="badge @(Model.IsInStock ? "bg-success" : "bg-danger") fs-6">
                            @(Model.IsInStock ? "In Stock" : "Out of Stock")
                        </span>
                        <a asp-action="Index" class="btn btn-outline-primary">Back to Catalog</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>